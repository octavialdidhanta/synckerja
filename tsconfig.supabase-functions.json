{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": false,
    "noImplicitAny": false,
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "https://esm.sh/@supabase/supabase-js@2": ["./node_modules/@supabase/supabase-js"],
      "https://esm.sh/date-fns@2": ["./node_modules/date-fns"]
    }
  },
  "include": ["supabase/functions/**/*.ts", "supabase/functions/deno-globals.d.ts"]
}
