#!/bin/sh
# Runs before every push from this clone (enable once with: git config core.hooksPath .githooks).
# Typecheck the Office app, then run only the tests related to the files this push changes.
# Emergency only: git push --no-verify
set -e

remote_main="origin/main"
git rev-parse --verify --quiet "$remote_main" >/dev/null || remote_main=""

changed=""
if [ -n "$remote_main" ]; then
  changed=$(git diff --name-only --diff-filter=ACMR "$remote_main"...HEAD -- 'src/**/*.ts' 'src/**/*.tsx' || true)
fi

if [ -z "$changed" ]; then
  echo "[pre-push] tidak ada perubahan di src/, cek dilewati."
  exit 0
fi

echo "[pre-push] typecheck…"
npm run -s typecheck

echo "[pre-push] tes yang terkait perubahan…"
# shellcheck disable=SC2086
npx vitest related --run --passWithNoTests $changed

echo "[pre-push] aman, lanjut push."
