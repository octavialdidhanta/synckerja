# Copy to `.env` for local Vite / Capacitor builds (values are inlined at `npm run build`).

# --- Supabase (required) ---
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=

# --- Meta / Instagram OAuth (Connect Instagram page) ---
# VITE_META_APP_ID=
# VITE_META_OAUTH_CONFIG_ID=   # Facebook Login for Business Configuration ID
# Supabase Edge Function secrets (Dashboard → Edge Functions → Secrets):
# META_APP_ID=  META_APP_SECRET=

# --- Meta Ads (Marketing API / offline conversion + metrics) ---
# Reuses META_APP_ID / META_APP_SECRET when META_ADS_* unset.
# META_ADS_APP_ID=
# META_ADS_APP_SECRET=
# META_ADS_CONFIG_ENCRYPTION_KEY=   # openssl rand -base64 32
# META_ADS_OAUTH_REDIRECT_URI=      # optional; default {SUPABASE_URL}/functions/v1/meta-ads-oauth-callback
# META_ADS_OAUTH_CONFIG_ID=         # optional; Facebook Login for Business config (or META_OAUTH_CONFIG_ID)
# META_GRAPH_API_VERSION=v22.0
# APP_PUBLIC_URL=                   # app origin for post-OAuth redirect

# --- TikTok Ads (Marketing API reporting) ---
# Supabase Edge Function secrets (Dashboard → Edge Functions → Secrets):
# TIKTOK_ADS_CLIENT_KEY=          # TikTok app ID (Synkerja Office)
# TIKTOK_ADS_CLIENT_SECRET=       # from TikTok Business API portal
# TIKTOK_ADS_CONFIG_ENCRYPTION_KEY=   # openssl rand -base64 32
# TIKTOK_ADS_OAUTH_REDIRECT_URI=  # optional; default {SUPABASE_URL}/functions/v1/tiktok-ads-oauth-callback
# APP_PUBLIC_URL=                 # app origin for post-OAuth redirect

# --- TikTok Content Insight (Login Kit v2 / Display API) ---
# Supabase Edge Function secrets:
# TIKTOK_CONTENT_CLIENT_KEY=7649637336472354817   # Synkerja Content Insight app ID
# TIKTOK_CONTENT_CLIENT_SECRET=                   # from TikTok Developer Portal
# TIKTOK_CONTENT_CONFIG_ENCRYPTION_KEY=           # optional; defaults to TIKTOK_ADS_CONFIG_ENCRYPTION_KEY
# TIKTOK_CONTENT_OAUTH_REDIRECT_URI=              # optional; default {SUPABASE_URL}/functions/v1/tiktok-content-oauth-callback

# --- YouTube Content Insight (Data API v3 + Analytics API) ---
# Supabase Edge Function secrets:
# YOUTUBE_CONTENT_CLIENT_ID=                      # Synkerja YouTube Content Insight OAuth client
# YOUTUBE_CONTENT_CLIENT_SECRET=
# YOUTUBE_CONTENT_CONFIG_ENCRYPTION_KEY=           # openssl rand -base64 32
# YOUTUBE_CONTENT_OAUTH_REDIRECT_URI=              # optional; default {SUPABASE_URL}/functions/v1/youtube-content-oauth-callback

# --- Google login / register (native + web SSO) ---
# Web client ID: same as Supabase Dashboard → Authentication → Providers → Google → Client ID
VITE_GOOGLE_SSO_WEB_CLIENT_ID=

# iOS only: OAuth client ID (application type iOS) from Google Cloud Console
# VITE_GOOGLE_SSO_IOS_CLIENT_ID=

# --- Google Drive preview (separate OAuth client; scope drive.file — NOT for login SSO) ---
# VITE_GOOGLE_CLIENT_ID=
# VITE_GOOGLE_OAUTH_REDIRECT_URI=
# Google Picker (GCP: enable Picker API + browser API key; App ID = Cloud project number)
# VITE_GOOGLE_PICKER_API_KEY=
# VITE_GOOGLE_PICKER_APP_ID=
