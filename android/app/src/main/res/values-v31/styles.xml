<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- API 31–34: nav bar gelap + ikon terang (kontras scrim via MainActivity di API 29+). -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/system_navigation_bar_background</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!-- Android 12+: sistem hanya menampilkan windowSplashScreenBackground + windowSplashScreenAnimatedIcon. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@color/splash_screen_background</item>
        <item name="android:windowSplashScreenBackground">@color/splash_screen_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_brand_icon</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
        <item name="android:statusBarColor">@android:color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/system_navigation_bar_background</item>
        <item name="android:windowLightNavigationBar">false</item>
        <!-- Setelah splash: pakai tema dengan nav bar hitam (bukan AppTheme Light default). -->
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
